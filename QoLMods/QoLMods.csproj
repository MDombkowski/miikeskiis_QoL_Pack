<Project Sdk="Microsoft.NET.Sdk">

  <!--
    miikeskii's QoL Pack: the bundle. One BepInEx 5 plugin for Valheim that runs every module, each in its own section
    of the bundle's settings. Build: dotnet build -c Release   (output: bin\Release\net472\QoLMods.dll)

    This folder holds only the bundle itself: its plugin (src\Plugin.cs), the kit (kit\, the one copy to edit) and the
    parts several modules share (parts\, such as the chest service, parts\Chests; the one copy to edit of each).
    Each module's code stays in its own mod folder and is compiled from there (the ItemGroup "The modules" below), so
    the bundle and each mod's single release are built from the same files. How to add a module: MODULES.md.

    Every reference points at a DLL where it already lives and is never copied (Private=false). Override the two
    folders on the command line if they are elsewhere, for example:
      dotnet build -c Release -p:ValheimManaged="D:\Games\Valheim\valheim_Data\Managed" -p:ModProfile="D:\Profiles\Test"
    No NuGet packages and no publicizer.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>QoLMods</AssemblyName>
    <RootNamespace>QoLMods</RootNamespace>
    <Version>0.57.1</Version>
    <!-- Keep the private repo's commit id out of the DLL's version text. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Use the .NET Framework 4.7.2 reference assemblies installed on this machine instead of fetching a package. -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <!-- Nothing to audit, and restore must not reach out to a package feed. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- Made with AI, declared where Thunderstore asks AI-made mods to (its wiki page "LLMs and AI-generated files",
       read 2026-09-27): here, which puts it in the DLL's AssemblyMetadata attributes, and in the README. -->
  <ItemGroup>
    <AssemblyMetadata Include="AI_Assisted_Creation" Value="This assembly was fully created with generative AI: its code was written by Claude agents (Anthropic, in Claude Code), directed by miikeskii." />
    <AssemblyMetadata Include="AI_Model_Vendor" Value="Anthropic" />
    <AssemblyMetadata Include="AI_Model" Value="Claude Opus 5 and Claude Opus 5.5" />
  </ItemGroup>

  <PropertyGroup>
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed</ValheimManaged>
    <ModProfile Condition="'$(ModProfile)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\Valheim\profiles\Default</ModProfile>
  </PropertyGroup>

  <!--
    The modules: each one's src\ folder, never its kit\ copy (the bundle compiles its own kit\) and never its
    standalone\ folder (its single release's plugin). One line per module; tools\package.ps1 and tools\sync-kit.ps1
    read the module folders from these lines.
  -->
  <ItemGroup>
    <Compile Include="..\XPortalMapPicker\src\**\*.cs" Link="Modules\XPortalMapPicker\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\MapZoom\src\**\*.cs" Link="Modules\MapZoom\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\TraderCircles\src\**\*.cs" Link="Modules\TraderCircles\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AddToCart\src\**\*.cs" Link="Modules\AddToCart\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\MapViewRules\src\**\*.cs" Link="Modules\MapViewRules\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\CraftFromChests\src\**\*.cs" Link="Modules\CraftFromChests\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ReserveStock\src\**\*.cs" Link="Modules\ReserveStock\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Handyman\src\**\*.cs" Link="Modules\Handyman\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\PortionControl\src\**\*.cs" Link="Modules\PortionControl\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ComfortBuild\src\**\*.cs" Link="Modules\ComfortBuild\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\StoreStash\src\**\*.cs" Link="Modules\StoreStash\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Terraformer\src\**\*.cs" Link="Modules\Terraformer\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ItemStandIcons\src\**\*.cs" Link="Modules\ItemStandIcons\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\UseCase\src\**\*.cs" Link="Modules\UseCase\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\BarNone\src\**\*.cs" Link="Modules\BarNone\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\HouseTrained\src\**\*.cs" Link="Modules\HouseTrained\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Outfitter\src\**\*.cs" Link="Modules\Outfitter\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Grounded\src\**\*.cs" Link="Modules\Grounded\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\PowerWheel\src\**\*.cs" Link="Modules\PowerWheel\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\SpareKeys\src\**\*.cs" Link="Modules\SpareKeys\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\TopperUpper\src\**\*.cs" Link="Modules\TopperUpper\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\MenUI\src\**\*.cs" Link="Modules\MenUI\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Hoarstone\src\**\*.cs" Link="Modules\Hoarstone\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AFKRaidBlocker\src\**\*.cs" Link="Modules\AFKRaidBlocker\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\WorldSettings\src\**\*.cs" Link="Modules\WorldSettings\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ZFighter\src\**\*.cs" Link="Modules\ZFighter\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\QuickFix\src\**\*.cs" Link="Modules\QuickFix\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\NapTime\src\**\*.cs" Link="Modules\NapTime\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Every reference any module needs. A module that needs a new one adds it here and to its own project. -->
  <ItemGroup>
    <!-- The game (assembly_utils holds ZInput, for Map Zoom) -->
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManaged)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's player accounts (PlatformUserID, PlatformManager), for Map View Rules: whose a pin is -->
    <Reference Include="Splatform">
      <HintPath>$(ValheimManaged)\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Terraformer: the ring on a round terrain tool's ghost (a particle system), grown with the radius -->
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ValheimManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Map View Rules: its zoom readout's text (TextMeshPro, as the map's own labels) and its buttons in a configuration
         manager's window (IMGUI) -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- House Trained: the navmesh's own queries for tames' wander points (a point put on a tame's own navmesh, whether
         a tame stands on it) -->
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Handyman: whether the game's Hide key is still held after it took the key's press (its Input System action) -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ValheimManaged)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BepInEx, HarmonyX and Jotunn, from the mod profile -->
    <Reference Include="BepInEx">
      <HintPath>$(ModProfile)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ModProfile)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>$(ModProfile)\BepInEx\plugins\ValheimModding-Jotunn\Jotunn.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Spare Keys: reading other mods' code once at start for keys they read with no setting (Mono.Cecil, shipped with BepInEx) -->
    <Reference Include="Mono.Cecil">
      <HintPath>$(ModProfile)\BepInEx\core\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
